# Keep this file private on the VPS as .backup.env (chmod 600).
# A local VPS copy alone is not a disaster-recovery backup. Configure an encrypted
# rclone remote and leave this enabled before accepting customer payments.
BACKUP_RETENTION_DAYS=7
REQUIRE_OFFSITE_BACKUP=true
# BACKUP_RCLONE_REMOTE=catcode-backups:catcode-license
