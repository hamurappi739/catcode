# Public HTTPS hostname used by the installed CatCode application.
API_DOMAIN=catcode-license-739.duckdns.org
PORT=3000
DATABASE_URL=postgresql://catcode_license:replace-me@db.example.com:5432/catcode_license?sslmode=require
# Use false only for a local, non-production PostgreSQL instance.
DATABASE_SSL=true
# Required by the Supabase shared pooler. `set-ca-cert.js` writes this value from
# the PEM certificate downloaded under Database > Settings > SSL Configuration.
DATABASE_CA_CERT_PEM=

# Generate all values with: npm run generate-secrets
LICENSE_KEY_HMAC_SECRET=replace-me
DEVICE_HMAC_SECRET=replace-me
EVENT_HMAC_SECRET=replace-me
ENTITLEMENT_PRIVATE_KEY_PEM="replace-me"
ENTITLEMENT_PUBLIC_KEY_PEM="replace-me"
ENTITLEMENT_KEY_ID=catcode-license-2026-01

# Development only. Production traffic must arrive through Caddy over HTTPS.
ALLOW_INSECURE_HTTP=false
TRUST_PROXY=true
ENTITLEMENT_TTL_SECONDS=86400
ACTIVATION_RATE_LIMIT=12
REFRESH_RATE_LIMIT=60
