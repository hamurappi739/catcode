[Unit]
Description=CatCode license database backup
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/home/catcode/catcode-license-server
ExecStart=/usr/bin/env bash scripts/backup-database.sh
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
